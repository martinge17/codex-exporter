# Codex Prometheus Exporter
LOG_LEVEL=info
CACHE_TTL_SECONDS=120 # Data refresh interval from OpenAI API. By default it's 2 minutes.
REQUEST_TIMEOUT_SECONDS=15
TOKEN_REFRESH_MARGIN_SECONDS=300

# Token state stores rotated OAuth tokens. Keep this path on a private volume.
CODEX_TOKEN_STATE_PATH=/data/codex-token-state.json

# Codex OAuth settings. Defaults match the Codex CLI public OAuth client.
CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CODEX_SCOPE=openid profile email offline_access api.connectors.read api.connectors.invoke
CODEX_ISSUER_URL=https://auth.openai.com
# Official Codex device-code flow uses these issuer-relative endpoints by default:
#   $CODEX_ISSUER_URL/api/accounts/deviceauth/usercode
#   $CODEX_ISSUER_URL/api/accounts/deviceauth/token
# Override only if OpenAI changes the endpoint.
# CODEX_DEVICE_USERCODE_URL=
# CODEX_DEVICE_TOKEN_URL=
CODEX_TOKEN_URL=https://auth.openai.com/oauth/token

# Codex usage endpoints. The exporter tries the fallback on 404.
CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
CODEX_USAGE_FALLBACK_URL=https://chatgpt.com/api/codex/usage
